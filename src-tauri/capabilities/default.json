{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capabilities for YT Desktop",
  "windows": ["main"],
  "remote": {
    "urls": [
      "https://*.youtube.com/*",
      "https://youtube.com/*",
      "https://accounts.google.com/*"
    ]
  },
  "permissions": [
    "core:default",
    "opener:default"
  ]
}
